      // drop
    } else if (jitterMaxMs > 0) {
      // Preserve frame order: each scheduled write must be at least 1ms
      // after the prior one. Floor against \`now\` so frames arriving
      // after a quiet stretch don't keep paying off accumulated delay
      // from earlier scheduling.
      const floor = Math.max(now, nextScheduledAt + 1)
      const target = Math.max(now + Math.random() * jitterMaxMs, floor)
      nextScheduledAt = target
      setTimeout(() => writer.write(value).catch(() => {}), target - now)
    } else {
      writer.write(value).catch(() => {})
    }
    reader.read().then(pump).catch(() => {})
  }
  reader.read().then(pump).catch(() => {})
})

self.addEventListener('message', (event) => {
  const data = event.data || {}
  if (data.type === 'stall' && typeof data.durationMs === 'number') {
    stallUntil = performance.now() + data.durationMs
  } else if (data.type === 'jitter' && typeof data.maxMs === 'number') {
    jitterMaxMs = Math.max(0, data.maxMs)
    nextScheduledAt = 0
  } else if (data.type === 'reset') {
    stallUntil = 0
    jitterMaxMs = 0
    nextScheduledAt = 0
  }
})
